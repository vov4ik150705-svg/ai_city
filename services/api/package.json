{
  "name": "@corporator/api",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "dependencies": {
    "@corporator/contentpack": "workspace:*",
    "@corporator/engine": "workspace:*",
    "@corporator/protocol": "workspace:*",
    "pg": "8.23.0",
    "@noble/secp256k1": "2.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.7",
    "embedded-postgres": "18.4.0-beta.17",
    "vitest": "4.1.11"
  },
  "scripts": {
    "test": "vitest run",
    "gate": "tsc --noEmit -p tsconfig.json && vitest run",
    "migrate:check": "node --experimental-strip-types ./src/migrate_check.ts"
  }
}
