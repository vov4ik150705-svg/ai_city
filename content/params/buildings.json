  "derived": {
    "affinity_matrix": "для каждой пары (роль, здание): home если home_contours роли содержит building.contour, neighbour если содержит contour_secondary, accepted если building.accepts_any, иначе отказ IDLE_WRONG_ROLE",
    "buildings_by_tier": "группировка по tier",
    "buildings_without_home_role": "здания с contour = null; каждое обязано иметь autonomous = true",
    "buildings_playable_v1": "base играбельно всегда; маяк — если playable_v1 его района; синергия — если играбельны все районы из requires. Ручного списка скоупа нет, он сверяется с фикстурой design_11_scope.json",
    "output_links": "для каждого архетипа с output_link: key output_bps, magnitude = node_effect_base_bps times building_link_quantum_mult times steps, target, exclusive_with, require_role. Рантайм не умножает",
    "building_link_quantum_bps": "node_effect_base_bps times modifiers.building_link_quantum_mult; baked into output_links magnitudes",
    "level_cost": "workshop_cost_l1 × cost_weight_bps(a) / 10000 × cost_growth_bps^(L−1) / 10000^(L−1); city_hall предпостроен, кривой нет",
    "level_output": "output(a,1) × output_growth_bps^(L−1), где output(a,1) = cost(a,1) × output_weight / 10000 / 240; считать от cost(a,1), не от cost(a,L)",
    "level_build_time": "ceil(cost_weight_bps(a) × build_time_growth_bps^(L−1) / 10000^L), минимум 1",
    "building_inputs": "energy если выведенный забор energy за тик > 0; compute если выведенный забор compute за тик > 0. Не хранится"
  }
